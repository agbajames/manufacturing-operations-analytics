model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Dim Date","Dim Product","Fact Daily Production","Fact Hourly Performance","Fact Downtime Events","Data Quality Report"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Dim Date'
ref table 'Dim Product'
ref table 'Fact Daily Production'
ref table 'Fact Hourly Performance'
ref table 'Fact Downtime Events'
ref table 'Data Quality Report'
ref table KPI_Measures

